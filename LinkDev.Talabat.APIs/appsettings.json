{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StoreContext": "Server =.\\SQLEXPRESS;Database = Talabat.APIs;Trusted_Connection = True;TrustServerCertificate= True;",
    "IdentityContext": "Server =.\\SQLEXPRESS;Database = Talabat.APIs.Identity;Trusted_Connection = True;TrustServerCertificate= True;",
    "Redis": "localhost"
  },
  "JwtSettings": {
    "Audience": "Talabat Users",
    "Issuer": "TalabatIdentity",
    "DurationInMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RedisSettings": {
    "TimeToLiveInDays": "16"
  },
  "Urls": {
    "ApiBaseUrl": "https://localhost:7178"
  }
}
