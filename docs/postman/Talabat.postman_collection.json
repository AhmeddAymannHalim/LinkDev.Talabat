{
  "info": {
    "name": "Talabat API",
    "description": "Every endpoint of the Talabat API, in the order a customer uses them. Run the whole collection with the Collection Runner (or newman): login saves the token automatically and later requests reuse the product, basket and order ids.\n\n1. Start the API (see the README) and select the 'Talabat - Local' environment.\n2. Run the collection from the top.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5086"
    },
    {
      "key": "password",
      "value": "P@ssw0rd!"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Account",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/account/register",
            "description": "Creates a user with a random email and returns a JWT. The password needs an upper-case letter, a lower-case letter, a digit and a symbol (6-10 characters).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Demo User\",\n  \"userName\": \"{{userName}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"01000000000\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Math.random().toString(36).slice(2, 10);",
                  "pm.collectionVariables.set(\"email\", `demo${id}@test.com`);",
                  "pm.collectionVariables.set(\"userName\", `demo${id}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/account/login",
            "description": "Returns a JWT. A wrong password or unknown email returns 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/account/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wr0ng!pw\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/account",
            "description": "Requires the Bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the logged-in email\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Email exists",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/account/emailexists?email={{email}}",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is true\", () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save address",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/account/address",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Halim\",\n  \"street\": \"1 Nile Street\",\n  \"city\": \"Cairo\",\n  \"country\": \"Egypt\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get address",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/account/address",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the saved street\", () => pm.expect(pm.response.json().street).to.eql(\"1 Nile Street\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?pageIndex=1&pageSize=5",
            "description": "Query: search, sort (priceAsc | priceDesc), brandId, categoryId, pageIndex, pageSize (max 10).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Has products and a total count\", () => { pm.expect(page.data).to.be.an(\"array\").and.not.empty; pm.expect(page.count).to.be.above(0); });",
                  "pm.collectionVariables.set(\"productId\", page.data[0].id);",
                  "pm.collectionVariables.set(\"productPrice\", page.data[0].price);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?search=cake",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Every result matches the search\", () => { const d = pm.response.json().data; pm.expect(d).to.not.be.empty; d.forEach(p => pm.expect(p.name.toLowerCase()).to.include(\"cake\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort by price (high to low)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?sort=priceDesc&pageSize=10",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Prices are descending\", () => { const p = pm.response.json().data.map(x => x.price); pm.expect(p).to.eql([...p].sort((a, b) => b - a)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by category and brand",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?categoryId=6&brandId=1",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a name and price\", () => { const p = pm.response.json(); pm.expect(p.name).to.be.a(\"string\"); pm.expect(p.price).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get an unknown product (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/99999",
            "description": "Errors use one uniform shape: statusCode and message.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Brands",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/brands",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns brands\", () => pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/categories",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns categories\", () => pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Basket",
      "item": [
        {
          "name": "Save basket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/basket",
            "description": "Baskets live in Redis and need no login (guests can shop). The id is chosen by the client.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{basketId}}\",\n  \"items\": [\n    {\n      \"id\": \"{{productId}}\",\n      \"productName\": \"Item\",\n      \"price\": \"{{productPrice}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"basketId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get basket",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/basket?id={{basketId}}",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Basket has one line\", () => pm.expect(pm.response.json().items).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save an invalid basket (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/basket",
            "description": "Quantity must be at least 1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"invalid\",\n  \"items\": [\n    {\n      \"id\": 1,\n      \"productName\": \"Item\",\n      \"price\": 10,\n      \"quantity\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Orders without a token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delivery methods",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/deliveryMethods",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const methods = pm.response.json();",
                  "pm.test(\"Returns delivery methods\", () => pm.expect(methods).to.not.be.empty);",
                  "pm.collectionVariables.set(\"deliveryMethodId\", methods.find(m => m.cost > 0).id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "description": "Prices always come from the database, never from the basket the client sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basketId\": \"{{basketId}}\",\n  \"deliveryMethodId\": \"{{deliveryMethodId}}\",\n  \"shippingAddress\": {\n    \"firstName\": \"Ahmed\",\n    \"lastName\": \"Halim\",\n    \"street\": \"1 Nile Street\",\n    \"city\": \"Cairo\",\n    \"country\": \"Egypt\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test(\"Buyer is the logged-in user\", () => pm.expect(order.buyerEmail).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"Total is subtotal plus delivery\", () => pm.expect(order.total).to.be.above(order.subTotal));",
                  "pm.collectionVariables.set(\"orderId\", order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Contains the new order\", () => pm.expect(pm.response.json().map(o => o.id)).to.include(Number(pm.collectionVariables.get(\"orderId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save an empty basket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/basket",
            "description": "Setup for the next request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{emptyBasketId}}\",\n  \"items\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emptyBasketId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order with an empty basket (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "description": "An order can't be created from an empty basket.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basketId\": \"{{emptyBasketId}}\",\n  \"deliveryMethodId\": \"{{deliveryMethodId}}\",\n  \"shippingAddress\": {\n    \"firstName\": \"Ahmed\",\n    \"lastName\": \"Halim\",\n    \"street\": \"1 Nile Street\",\n    \"city\": \"Cairo\",\n    \"country\": \"Egypt\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Cleanup",
      "item": [
        {
          "name": "Delete basket",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/basket?id={{basketId}}",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
